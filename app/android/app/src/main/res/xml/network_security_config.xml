<?xml version="1.0" encoding="utf-8"?>
<!-- Everything leaves the phone through Tor, encrypted. The one plain
     connection is to Sanctum's own video relay on this phone (127.0.0.1),
     which fetches Explore videos through Tor for the player. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
